public class NombreComplexe {
    private double reel;
    private double imaginaire;

    // Constructeur
    public NombreComplexe(double reel, double imaginaire) {
        this.reel = reel;
        this.imaginaire = imaginaire;
    }

    // Méthode pour additionner deux nombres complexes
    public NombreComplexe addition(NombreComplexe autre) {
        double newReel = this.reel + autre.reel;
        double newImaginaire = this.imaginaire + autre.imaginaire;
        return new NombreComplexe(newReel, newImaginaire);
    }

    // Méthode pour multiplier deux nombres complexes
    public NombreComplexe multiplication(NombreComplexe autre) {
        double newReel = (this.reel * autre.reel) - (this.imaginaire * autre.imaginaire);
        double newImaginaire = (this.reel * autre.imaginaire) + (this.imaginaire * autre.reel);
        return new NombreComplexe(newReel, newImaginaire);
    }

    // Méthode pour afficher le nombre complexe
    public void afficher() {
        if (imaginaire >= 0)
            System.out.println(reel + " + " + imaginaire + "i");
        else
            System.out.println(reel + " - " + (-imaginaire) + "i");
    }

    public static void main(String[] args) {
        // Créer deux nombres complexes
        NombreComplexe c1 = new NombreComplexe(3, 2);
        NombreComplexe c2 = new NombreComplexe(1, 7);

        // Addition des deux nombres complexes
        NombreComplexe somme = c1.addition(c2);
        System.out.print("Somme : ");
        somme.afficher();

        // Multiplication des deux nombres complexes
        NombreComplexe produit = c1.multiplication(c2);
        System.out.print("Produit : ");
        produit.afficher();
    }
}
